{
 "glossary": [
  {
   "term": "5-inch",
   "def": "A common freestyle quad class with 5-inch props; more power and range than a whoop."
  },
  {
   "term": "Acro / Rate mode",
   "def": "Manual flight mode with no self-leveling; the sticks command rotation rate. Required for nearly every freestyle trick."
  },
  {
   "term": "Arm",
   "def": "Enabling the motors so the quad will spin up. You arm before takeoff (usually on a switch) and disarm to cut power."
  },
  {
   "term": "AUX / switch",
   "def": "An auxiliary channel on the radio, used to arm, change modes, or trigger features mid-flight."
  },
  {
   "term": "Bando",
   "def": "An abandoned building or structure that pilots treat as a freestyle playground. Short for 'abandoned'."
  },
  {
   "term": "Betaflight",
   "def": "The most common open-source flight-control firmware, where rates, flight modes, and tuning are set up."
  },
  {
   "term": "Blip",
   "def": "A brief tap of throttle, used to nudge altitude or kick a stalled quad back into motion."
  },
  {
   "term": "BNF / RTF",
   "def": "Bind-N-Fly (needs your own radio) / Ready-To-Fly (includes everything)."
  },
  {
   "term": "Cinewhoop",
   "def": "A small ducted quad built for smooth cinematic flying in tight spaces."
  },
  {
   "term": "CLM",
   "def": "Camera-Locked Motion, keeping a subject fixed in frame throughout a trick, a scoring requirement in competition."
  },
  {
   "term": "Disarm",
   "def": "Cutting motor power. A 'slide disarm' or 'crash and disarm' ends a line deliberately."
  },
  {
   "term": "Failsafe",
   "def": "The programmed response when the quad loses its radio or video link, usually cutting the motors or holding position to prevent a flyaway."
  },
  {
   "term": "FPV",
   "def": "First-Person View, flying via a live camera feed to goggles or a screen. Is not a crime."
  },
  {
   "term": "Freestyle",
   "def": "Expressive, trick-oriented flying (as opposed to racing)."
  },
  {
   "term": "Horizon mode",
   "def": "A self-leveling mode that still lets you flip and roll, then eases back toward level when you release the sticks. Angle mode is fully self-leveling; Acro has no leveling at all."
  },
  {
   "term": "Invert",
   "def": "Flipping the quad upside-down; many tricks pass through or hold an inverted state."
  },
  {
   "term": "LiPo",
   "def": "Lithium-polymer battery, the high-discharge packs that power most FPV quads. Store and charge them carefully."
  },
  {
   "term": "LOS",
   "def": "Line-Of-Sight, keeping visual contact with the aircraft, often a legal requirement."
  },
  {
   "term": "Powerloop",
   "def": "A loop up-and-over an obstacle using throttle through the top; also a whole trick family."
  },
  {
   "term": "Prop wash",
   "def": "Turbulent air thrown off the quad's own props, felt as a jittery wobble when you descend through it or stop hard."
  },
  {
   "term": "Punch / punch-out",
   "def": "A sharp burst of throttle for a fast vertical climb."
  },
  {
   "term": "Rates",
   "def": "Radio settings that map stick travel to rotation speed. Lower rates = gentler, higher = snappier."
  },
  {
   "term": "Rewind",
   "def": "Reversing a motion back along its entry path, often out of a stall."
  },
  {
   "term": "Stall",
   "def": "Chopping throttle so the quad momentarily stops flying and hangs or drops before recovery."
  },
  {
   "term": "Throttle",
   "def": "Motor power, the left stick's vertical axis in Mode 2."
  },
  {
   "term": "VTX",
   "def": "Video transmitter, the part that beams the camera feed from the quad to your goggles."
  },
  {
   "term": "Whoop",
   "def": "A micro ducted FPV drone (typically 65 to 85mm); safe, agile, great for learning."
  },
  {
   "term": "Yaw",
   "def": "Rotation about the vertical axis, the drone turning left/right in place."
  }
 ],
